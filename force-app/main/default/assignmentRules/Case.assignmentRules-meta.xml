<?xml version="1.0" encoding="UTF-8" ?>
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>HowTo_Video_Requests</fullName>
        <active>true</active>
        <ruleEntry>
            <assignedTo>HowTo_Triage_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Case.RecordTypeId</field>
                <operation>equals</operation>
                <value>Video Request</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <criteriaItems>
                <field>Case.RecordTypeId</field>
                <operation>notEqual</operation>
                <value>Video Request</value>
            </criteriaItems>
        </ruleEntry>
    </assignmentRule>
</AssignmentRules>

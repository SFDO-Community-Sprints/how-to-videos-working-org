<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Content_Drive_Folder_Required</fullName>
    <active>true</active>
    <description
  >The Drive folder is required in Production, Editing, and Final Review.</description>
    <errorConditionFormula
  >AND(OR(ISPICKVAL(Status__c, &quot;Production&quot;), ISPICKVAL(Status__c, &quot;Editing&quot;), ISPICKVAL(Status__c, &quot;Final Review&quot;)), ISBLANK(Drive_Folder__c))</errorConditionFormula>
    <errorDisplayField>Drive_Folder__c</errorDisplayField>
    <errorMessage
  >Enter the Drive folder before moving content to Production.</errorMessage>
</ValidationRule>

        <label>Ask for likely matches</label>
        <locationX>176</locationX>
        <locationY>650</locationY>
        <actionName>HowTo_Duplicate_Check</actionName>
        <actionType>generatePromptResponse</actionType>
        <connector>
            <targetReference>Did_the_check_answer</targetReference>

            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>No_content_yet</name>
        <label>No content yet</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>suggestions</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue
        >There is no content yet, so this request cannot duplicate anything.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Any_content</name>
        <label>Any content?</label>
        <locationX>176</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Ask_for_likely_matches</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Yes</defaultConnectorLabel>
        <rules>
            <name>None</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>contentTitles</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>No_content_yet</targetReference>
            </connector>
            <label>None</label>
        </rules>
    </decisions>
    <decisions>
        <name>Did_the_check_answer</name>
        <label>Did the check answer?</label>
        <locationX>176</locationX>
        <locationY>758</locationY>
        <defaultConnectorLabel>Yes</defaultConnectorLabel>
        <rules>
            <name>Empty_answer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>suggestions</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_returned_nothing</targetReference>
            </connector>
            <label>Empty answer</label>
        </rules>
    </decisions>
    <description
  >How-To Videos: the duplicate check that both triage flows show. Lists every content title with its status, asks the How-To Duplicate Check prompt template for likely matches, and returns them as text. If the model call fails or returns nothing, it returns a message that says to search by hand, and the triage flow carries on (ADR 0005).</description>
    <environments>Default</environments>
    <interviewLabel
  >How-To duplicate check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>How-To: Duplicate Check</label>
    <loops>
        <name>For_each_content</name>
        <label>For each content</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <collectionReference>Get_all_content</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_title_to_list</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Any_content</targetReference>
        </noMoreValuesConnector>
    </loops>

<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description
    >Calls the How-To Duplicate Check prompt template with the request&apos;s title and description and the list of content titles. Never sends the requester&apos;s name or email (ADR 0005).</description>

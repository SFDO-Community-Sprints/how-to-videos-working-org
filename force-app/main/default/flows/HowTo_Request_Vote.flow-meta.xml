<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <description
    >The count must match the requests, so a failure stops the triage and shows why.</description>
        <name>Vote_failed</name>
        <label>Vote failed</label>
        <locationX>900</locationX>
        <locationY>500</locationY>
        <customErrorMessages>
            <errorMessage
      >The requester&apos;s vote could not be recorded, so the request was not saved. Try again. The error was: {!$Flow.FaultMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Has_this_person_voted</name>
        <label>Has this person voted?</label>
        <locationX>176</locationX>
        <locationY>700</locationY>
        <defaultConnector>
            <targetReference>Cast_the_vote</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Already_voted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_an_existing_vote</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_it_as_from_the_request</targetReference>
            </connector>
            <label>Already voted</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_it_linked_to_open_content</name>
        <label>Is it linked to open content?</label>
        <locationX>176</locationX>
        <locationY>500</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Open_content</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.HowTo_Content__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.HowTo_Content__r.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Declined</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.HowTo_Content__r.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Published</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >$Record.HowTo_Content__r.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Retired</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_an_existing_vote</targetReference>
            </connector>
            <label>Open content</label>
        </rules>
    </decisions>
    <decisions>
        <name>Remove_the_old_vote</name>
        <label>Remove the old vote?</label>
        <locationX>400</locationX>
        <locationY>300</locationY>
        <defaultConnector>
            <targetReference>Is_it_linked_to_open_content</targetReference>
        </defaultConnector>
        <defaultConnectorLabel
    >No: none, or another request still asks</defaultConnectorLabel>
        <rules>
            <name>Remove_it</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_the_old_vote</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >Get_another_request_from_this_address</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_the_old_vote</targetReference>
            </connector>
            <label>Remove it</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_it_counted_already</name>
        <label>Was it counted already?</label>
        <locationX>400</locationX>
        <locationY>920</locationY>
        <defaultConnector>
            <targetReference>Vote_failed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Counted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >Get_the_vote_after_a_clash</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_it_as_from_the_request</targetReference>
            </connector>
            <label>Counted</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_it_linked_before</name>
        <label>Was it linked before?</label>
        <locationX>176</locationX>
        <locationY>100</locationY>
        <defaultConnector>
            <targetReference>Is_it_linked_to_open_content</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Linked_before</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record__Prior.HowTo_Content__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_the_old_vote</targetReference>
            </connector>
            <label>Linked before</label>
        </rules>
    </decisions>
    <description
  >How-To Videos: a qualified request counts as a vote for its requester (ADR 0003). When a Video Request is linked to content that is open for votes, casts a vote keyed on the content and the requester&apos;s email in lower case (when two requests from one address arrive together, the unique key refuses the second, which then counts as already cast); if that person already voted on the board, marks the vote as from the request instead, so it cannot be withdrawn while the request stands. When the request is relinked or unlinked, removes the vote it cast unless another request from the same address still points to the old content. Declined, Published and Retired content get no new vote. Runs in system context: team members hold no access to votes.</description>
    <environments>Default</environments>
    <formulas>
        <name>Email_lowercase</name>
        <dataType>String</dataType>
        <expression>LOWER({!$Record.SuppliedEmail})</expression>
    </formulas>
    <formulas>
        <name>New_key</name>
        <dataType>String</dataType>
        <expression
    >{!$Record.HowTo_Content__c} &amp; LOWER({!$Record.SuppliedEmail})</expression>
    </formulas>
    <formulas>
        <name>Old_key</name>
        <dataType>String</dataType>
        <expression
    >{!$Record__Prior.HowTo_Content__c} &amp; LOWER({!$Record.SuppliedEmail})</expression>
    </formulas>
    <interviewLabel
  >How-To request vote {!$Flow.CurrentDateTime}</interviewLabel>
    <label>How-To: Request Counts as a Vote</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Cast_the_vote</name>
        <label>Cast the vote</label>
        <locationX>176</locationX>
        <locationY>820</locationY>
        <faultConnector>
            <targetReference>Get_the_vote_after_a_clash</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Content__c</field>
            <value>
                <elementReference>$Record.HowTo_Content__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Source__c</field>
            <value>
                <stringValue>Request</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Voter_Email__c</field>
            <value>
                <elementReference>Email_lowercase</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Voter_Key__c</field>
            <value>
                <elementReference>New_key</elementReference>
            </value>
        </inputAssignments>
        <object>Vote__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordDeletes>
        <name>Delete_the_old_vote</name>
        <label>Delete the old vote</label>
        <locationX>400</locationX>
        <locationY>400</locationY>
        <connector>
            <targetReference>Is_it_linked_to_open_content</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Vote_failed</targetReference>
        </faultConnector>
        <inputReference>Get_the_old_vote</inputReference>
    </recordDeletes>
    <recordLookups>
        <name>Get_an_existing_vote</name>
        <label>Get an existing vote</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <assignNullValuesIfNoRecordsFound
    >true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_this_person_voted</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Vote_failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Voter_Key__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>New_key</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vote__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Source__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_another_request_from_this_address</name>
        <label>Get another request from this address</label>
        <locationX>400</locationX>
        <locationY>200</locationY>
        <assignNullValuesIfNoRecordsFound
    >true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Remove_the_old_vote</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Vote_failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>HowTo_Content__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference
        >$Record__Prior.HowTo_Content__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>SuppliedEmail</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.SuppliedEmail</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_the_old_vote</name>
        <label>Get the old vote</label>
        <locationX>400</locationX>
        <locationY>100</locationY>
        <assignNullValuesIfNoRecordsFound
    >true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference
      >Get_another_request_from_this_address</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Vote_failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Voter_Key__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Old_key</elementReference>
            </value>
        </filters>
        <filters>
            <field>Source__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Request</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vote__c</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_the_vote_after_a_clash</name>
        <label>Get the vote after a clash</label>
        <locationX>400</locationX>
        <locationY>820</locationY>
        <assignNullValuesIfNoRecordsFound
    >true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Was_it_counted_already</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Vote_failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Voter_Key__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>New_key</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vote__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Source__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Mark_it_as_from_the_request</name>
        <label>Mark it as from the request</label>
        <locationX>400</locationX>
        <locationY>700</locationY>
        <faultConnector>
            <targetReference>Vote_failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Voter_Key__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>New_key</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Source__c</field>
            <value>
                <stringValue>Request</stringValue>
            </value>
        </inputAssignments>
        <object>Vote__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Was_it_linked_before</targetReference>
        </connector>
        <filterFormula
    >AND({!$Record.RecordType.DeveloperName} = &quot;HowTo_Video_Request&quot;, NOT(ISBLANK({!$Record.SuppliedEmail})), OR(AND(ISNEW(), NOT(ISBLANK({!$Record.HowTo_Content__c}))), ISCHANGED({!$Record.HowTo_Content__c})))</filterFormula>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>

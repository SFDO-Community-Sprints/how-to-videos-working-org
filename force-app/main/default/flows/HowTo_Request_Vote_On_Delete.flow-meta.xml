<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <description
    >The count must match the requests, so a failure stops the save and shows why.</description>
        <name>Vote_failed</name>
        <label>Vote failed</label>
        <locationX>1100</locationX>
        <locationY>500</locationY>
        <customErrorMessages>
            <errorMessage
      >The vote this request cast could not be released, so the request was not deleted. The error was: {!$Flow.FaultMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Already_released</name>
        <label>Already released?</label>
        <locationX>800</locationX>
        <locationY>540</locationY>
        <defaultConnector>
            <targetReference>Vote_failed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Gone</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_the_old_vote_again</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Gone</label>
        </rules>
    </decisions>
    <decisions>
        <name>Another_request_still_asks</name>
        <label>Another request still asks?</label>
        <locationX>500</locationX>
        <locationY>300</locationY>
        <defaultConnector>
            <targetReference>Was_it_a_board_vote</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_keep_it</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >Get_another_request_from_the_old_address</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes, keep the vote</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_there_an_old_vote</name>
        <label>Is there an old vote?</label>
        <locationX>500</locationX>
        <locationY>100</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Old_vote</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_the_old_vote</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference
        >Get_another_request_from_the_old_address</targetReference>
            </connector>
            <label>Old vote</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_it_a_board_vote</name>
        <label>Was it a board vote?</label>
        <locationX>500</locationX>
        <locationY>420</locationY>
        <defaultConnector>
            <targetReference>Delete_the_old_vote</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Board_vote</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >Get_the_old_vote.Voter__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Give_it_back_to_the_board</targetReference>
            </connector>
            <label>Board vote</label>
        </rules>
    </decisions>
    <description
  >How-To Videos: when a Video Request is deleted, releases the vote it cast (ADR 0003). Only a Video Request can point to content, so the entry needs no record type check. The vote stays if another request from the same address still points to the content; a board vote that the request took over goes back to the board; otherwise the vote is deleted.</description>
    <environments>Default</environments>
    <formulas>
        <name>Key</name>
        <dataType>String</dataType>
        <expression
    >{!$Record.HowTo_Content__c} &amp; LOWER({!$Record.SuppliedEmail})</expression>
    </formulas>
    <interviewLabel
  >How-To request vote on delete {!$Flow.CurrentDateTime}</interviewLabel>
    <label>How-To: Release a Deleted Request&apos;s Vote</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordDeletes>
        <description
    >If two requests from one address release this vote in one save, the second delete fails and the fault path finds it gone.</description>
        <name>Delete_the_old_vote</name>
        <label>Delete the old vote</label>
        <locationX>500</locationX>
        <locationY>540</locationY>
        <faultConnector>
            <targetReference>Get_the_old_vote_again</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Voter_Key__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Key</elementReference>
            </value>
        </filters>
        <object>Vote__c</object>
    </recordDeletes>
    <recordLookups>
        <name>Get_another_request_from_the_old_address</name>
        <label>Get another request from the old address</label>
        <locationX>500</locationX>
        <locationY>200</locationY>
        <assignNullValuesIfNoRecordsFound
    >true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Another_request_still_asks</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Vote_failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>HowTo_Content__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.HowTo_Content__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>SuppliedEmail</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.SuppliedEmail</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_the_old_vote</name>
        <label>Get the old vote</label>
        <locationX>500</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound
    >true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_there_an_old_vote</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Vote_failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Voter_Key__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Key</elementReference>
            </value>
        </filters>
        <filters>
            <field>Source__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Request</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vote__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Voter__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_the_old_vote_again</name>
        <label>Get the old vote again</label>
        <locationX>800</locationX>
        <locationY>440</locationY>
        <assignNullValuesIfNoRecordsFound
    >true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Already_released</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Vote_failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Voter_Key__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Key</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vote__c</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Give_it_back_to_the_board</name>
        <label>Give it back to the board</label>
        <locationX>700</locationX>
        <locationY>420</locationY>
        <faultConnector>
            <targetReference>Vote_failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Voter_Key__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Key</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Source__c</field>
            <value>
                <stringValue>Voting Board</stringValue>
            </value>
        </inputAssignments>
        <object>Vote__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_the_old_vote</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>HowTo_Content__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>SuppliedEmail</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
</Flow>

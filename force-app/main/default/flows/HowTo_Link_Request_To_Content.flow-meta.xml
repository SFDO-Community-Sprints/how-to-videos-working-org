    <recordUpdates>
        <description
    >Qualified and linked together, as the request rules require. Saving it sends the triage email.</description>
        <name>Qualify_the_request</name>
        <label>Qualify the request</label>
        <locationX>176</locationX>
        <locationY>870</locationY>
        <connector>
            <targetReference>Request_linked</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Undo_changes</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>HowTo_Content__c</field>
            <value>
                <elementReference>Get_the_chosen_content.Id</elementReference>

<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Can_it_take_requests</name>
        <label>Can it take requests?</label>
        <locationX>176</locationX>
        <locationY>760</locationY>
        <defaultConnector>
            <targetReference>Qualify_the_request</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Yes</defaultConnectorLabel>
        <rules>
            <name>Declined_or_retired</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference
        >Get_the_chosen_content.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Declined</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference
        >Get_the_chosen_content.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Retired</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Cannot_link</targetReference>
            </connector>
            <label>Declined or retired</label>
        </rules>
    </decisions>
    <decisions>
        <description
    >The create flow runs in system mode, so both triage flows check the Queue Manager&apos;s custom permission first.</description>
        <name>Can_this_person_triage</name>
        <label>Can this person triage?</label>
        <locationX>176</locationX>
        <locationY>100</locationY>
        <defaultConnector>
            <targetReference>Not_allowed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Queue_Manager</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Permission.HowTo_Triage_Requests</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_the_request</targetReference>
            </connector>
            <label>Queue Manager</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_it_waiting_for_triage</name>
        <label>Is it waiting for triage?</label>
        <locationX>176</locationX>
        <locationY>320</locationY>
        <defaultConnector>
            <targetReference>Already_triaged</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>New_video_request</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >Get_the_request.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>HowTo_Video_Request</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_the_request.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_for_duplicates</targetReference>
            </connector>
            <label>New video request</label>
        </rules>
    </decisions>
    <description
  >How-To Videos: the Queue Manager links a request to content that already exists. Shows the duplicate check, lets the Queue Manager choose the content, refuses Declined or Retired content, then marks the request Qualified and linked. Runs in user mode; checks the Triage Requests permission first.</description>
    <environments>Default</environments>
    <interviewLabel
  >How-To link request {!$Flow.CurrentDateTime}</interviewLabel>
    <label>How-To: Link Request to Existing Content</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>

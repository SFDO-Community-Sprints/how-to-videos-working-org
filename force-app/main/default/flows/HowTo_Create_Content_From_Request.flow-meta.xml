<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description
    >The create flow runs in system mode, so both triage flows check the Queue Manager&apos;s custom permission first.</description>
        <name>Can_this_person_triage</name>
        <label>Can this person triage?</label>
        <locationX>176</locationX>
        <locationY>100</locationY>
        <defaultConnector>
            <targetReference>Not_allowed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Queue_Manager</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Permission.HowTo_Triage_Requests</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_the_request</targetReference>
            </connector>
            <label>Queue Manager</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_it_waiting_for_triage</name>
        <label>Is it waiting for triage?</label>
        <locationX>176</locationX>
        <locationY>320</locationY>
        <defaultConnector>
            <targetReference>Already_triaged</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>New_video_request</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >Get_the_request.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>HowTo_Video_Request</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_the_request.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_for_duplicates</targetReference>
            </connector>
            <label>New video request</label>
        </rules>
    </decisions>
    <description
  >How-To Videos: the Queue Manager creates content from a request when no content exists for it. Shows the duplicate check, creates the content as an idea (Submitted) owned by the queue Content Awaiting a Holder, copies product, feature and champion from the request, then marks the request Qualified and linked. Runs in system mode with sharing so it can copy the champion, which only Team Leadership can edit by hand; it checks the Triage Requests permission first.</description>
    <environments>Default</environments>
    <formulas>
        <name>Title_from_request</name>
        <dataType>String</dataType>
        <expression>LEFT({!Get_the_request.Subject}, 80)</expression>
    </formulas>
    <interviewLabel
  >How-To create content {!$Flow.CurrentDateTime}</interviewLabel>
    <label>How-To: Create Content From Request</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_the_content</name>
        <label>Create the content</label>
        <locationX>176</locationX>
        <locationY>760</locationY>
        <connector>
            <targetReference>Qualify_the_request</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Undo_changes</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Champion_Email__c</field>
            <value>
                <elementReference
        >Get_the_request.SuppliedEmail</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Champion_Name__c</field>
            <value>
                <elementReference
        >Get_the_request.SuppliedName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Feature__c</field>
            <value>
                <elementReference
        >Get_the_request.HowTo_Feature__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>Title</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Get_the_holder_queue.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Product__c</field>
            <value>
                <elementReference
        >Get_the_request.HowTo_Product__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Submitted</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Summary__c</field>
            <value>
                <elementReference>Summary</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type__c</field>
            <value>
                <stringValue>Video</stringValue>
            </value>
        </inputAssignments>
        <object>HowToContent__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_the_holder_queue</name>
        <label>Get the holder queue</label>
        <locationX>176</locationX>
        <locationY>650</locationY>
        <assignNullValuesIfNoRecordsFound
    >false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_the_content</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Something_went_wrong</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>HowTo_Content_Awaiting_Holder</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_the_request</name>
        <label>Get the request</label>
        <locationX>176</locationX>
        <locationY>210</locationY>
        <assignNullValuesIfNoRecordsFound
    >false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_it_waiting_for_triage</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Something_went_wrong</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Subject</queriedFields>
        <queriedFields>Description</queriedFields>
        <queriedFields>SuppliedName</queriedFields>
        <queriedFields>SuppliedEmail</queriedFields>
        <queriedFields>HowTo_Product__c</queriedFields>
        <queriedFields>HowTo_Feature__c</queriedFields>
        <queriedFields>Status</queriedFields>
        <queriedFields>RecordTypeId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordRollbacks>
        <description
    >Undoes anything this flow saved before the failure, so the request and content stay as they were.</description>
        <name>Undo_changes</name>
        <label>Undo changes</label>
        <locationX>900</locationX>
        <locationY>600</locationY>
        <connector>
            <targetReference>Something_went_wrong</targetReference>
        </connector>
    </recordRollbacks>
    <recordUpdates>
        <description
    >Qualified and linked together, as the request rules require. Saving it sends the triage email.</description>
        <name>Qualify_the_request</name>
        <label>Qualify the request</label>
        <locationX>176</locationX>
        <locationY>870</locationY>
        <connector>
            <targetReference>Content_created</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Undo_changes</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>HowTo_Content__c</field>
            <value>
                <elementReference>Create_the_content</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Qualified</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <runInMode>SystemModeWithSharing</runInMode>
    <screens>
        <name>Already_triaged</name>
        <label>Already triaged</label>
        <locationX>500</locationX>
        <locationY>320</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Already_triaged_text</name>
            <fieldText
      >&lt;p&gt;This request is not a new Video Request, so it has already been triaged. Nothing was changed.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Content_created</name>
        <label>Content created</label>
        <locationX>176</locationX>
        <locationY>980</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Content_created_text</name>
            <fieldText
      >&lt;p&gt;Content created: {!Title}. It is an idea now, waiting for a holder. The request is Qualified, and the requester was emailed.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Describe_the_content</name>
        <label>Describe the content</label>
        <locationX>176</locationX>
        <locationY>540</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Get_the_holder_queue</targetReference>
        </connector>
        <fields>
            <name>Duplicate_check_results</name>
            <fieldText
      >&lt;p&gt;&lt;strong&gt;Possible matches from the duplicate check&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;{!suggestions}&lt;/p&gt;&lt;p&gt;The check only suggests. You decide.&lt;/p&gt;&lt;p&gt;If one of them is what this request asks for, cancel and use Link to Existing Content instead.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Title</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>Title_from_request</elementReference>
            </defaultValue>
            <fieldText>Title</fieldText>
            <fieldType>InputField</fieldType>
            <helpText
      >&lt;p&gt;Up to 80 characters. It starts as the request&apos;s title.&lt;/p&gt;</helpText>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage
        >&lt;p&gt;Use 80 characters or fewer.&lt;/p&gt;</errorMessage>
                <formulaExpression>LEN({!Title}) &lt;= 80</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>Summary</name>
            <defaultValue>
                <elementReference>Get_the_request.Description</elementReference>
            </defaultValue>
            <fieldText>Summary</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Create content</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>

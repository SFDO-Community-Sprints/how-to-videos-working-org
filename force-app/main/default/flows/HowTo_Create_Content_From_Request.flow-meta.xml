            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Can_this_person_triage</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <description
    >Shows likely duplicates. Carries on with a &quot;search by hand&quot; message if the model call fails (ADR 0005).</description>
        <name>Check_for_duplicates</name>
        <label>Check for duplicates</label>
        <locationX>176</locationX>
        <locationY>430</locationY>
        <connector>
            <targetReference>Describe_the_content</targetReference>
        </connector>
        <flowName>HowTo_Duplicate_Check_Run</flowName>
        <inputAssignments>
            <name>requestDescription</name>
            <value>
                <elementReference>Get_the_request.Description</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>requestTitle</name>
            <value>
                <elementReference>Get_the_request.Subject</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>suggestions</assignToReference>
            <name>suggestions</name>
        </outputAssignments>
    </subflows>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>suggestions</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
